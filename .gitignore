# ---- secrets (never commit) ----
*.env
.env
.env.*
.dev.vars
*.keystore
*.jks
# The debug key is deliberately tracked: a per-machine key means every
# build has a different signature, so no APK can be installed over the
# previous one. Release keys stay excluded by the rules above.
!android/debug.keystore
secrets/
local.properties

# ---- android ----
.gradle/
build/
captures/
.cxx/
*.apk
*.aab
*.ap_
*.dex
.idea/
*.iml

# ---- python / windows ----
__pycache__/
*.py[cod]
.venv/
venv/
dist/
*.spec.bak
.pytest_cache/
.mypy_cache/

# ---- node / backend ----
node_modules/
.wrangler/
.dev.vars.*
*.tsbuildinfo
coverage/

# ---- os / editors ----
.DS_Store
Thumbs.db
*.swp

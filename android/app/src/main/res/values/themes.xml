<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A bare dark shell. All real styling is Compose (ui/theme), so this
      only needs to avoid a white flash before the first frame.
    -->
    <style name="Theme.Jarvis" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
